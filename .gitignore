# Dependencies
node_modules/
**/node_modules/

# Build outputs
build/
dist/
/packages/*/lib/
out/
.docusaurus/
.cache-loader/
*.tsbuildinfo

# Theme dist is an exception: brand-palette.css is hand-authored and tokens.css
# is generated, but both ship with the workspace package and are imported by
# consumers (CLI's global.css). CI doesn't run any per-package build before
# the CLI build, so these have to be checked in.
!/packages/theme/dist/
!/packages/theme/dist/*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env files
.env
.env.*

# OS
.DS_Store

# IDE
.vscode/

# Claude
.claude/settings.local.json
.claude/settings.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Coverage
coverage/

# Firebase
.firebase/
firebase-debug.log
firebase-key.json

# Misc
.cache/
