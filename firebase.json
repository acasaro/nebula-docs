{
  "functions": {
    "source": "functions",
    "predeploy": ["pnpm --filter @nebula/functions build"],
    "ignore": ["node_modules", ".git", "*.local", "src", "tsconfig.json"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
