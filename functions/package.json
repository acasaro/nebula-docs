{
  "name": "@nebula-docs/functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "start": "pnpm shell",
    "deploy": "firebase deploy --only functions",
    "deploy:dev": "firebase deploy --only functions:mintGithubTokenDev,functions:getInstallationDev,functions:githubWebhookDev",
    "deploy:prod": "firebase deploy --only functions:mintGithubToken,functions:getInstallation,functions:githubWebhook",
    "logs": "firebase functions:log",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(eslint TBD)\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.4",
    "@octokit/rest": "^21.1.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
