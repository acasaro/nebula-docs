{
  "name": "mcoe-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:docs": "pnpm --filter @mcoe/docs start",
    "dev:nebula": "pnpm --filter @mcoe/nebula-cms dev",
    "build:docs": "pnpm --filter @mcoe/docs build",
    "build:nebula": "pnpm --filter @mcoe/nebula-cms build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r --parallel exec rm -rf node_modules dist build .docusaurus && rm -rf node_modules"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "html-webpack-plugin": "5.6.3"
    }
  }
}
