{
  "name": "@nebula-docs/cli",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "Multi-tenant docs renderer + tooling for Nebula Docs. Astro + MDX + React + Tailwind v4.",
  "bin": {
    "nebula": "./bin/nebula.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "astro.config.mjs",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schemas/docs": "./schemas/docs.schema.json",
    "./schemas/theme": "./schemas/theme.schema.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx ./bin/nebula.mjs dev",
    "build": "tsx ./bin/nebula.mjs build",
    "preview": "tsx ./bin/nebula.mjs preview",
    "validate": "tsx ./bin/nebula.mjs validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@nebula-docs/analytics": "workspace:*",
    "@nebula-docs/components": "workspace:*",
    "@nebula-docs/mdx": "workspace:*",
    "@nebula-docs/schemas": "workspace:*",
    "@nebula-docs/theme": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.2",
    "pagefind": "^1.5.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "<JFROG_NPM_LOCAL_URL>"
  }
}
