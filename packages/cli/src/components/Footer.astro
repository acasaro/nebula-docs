---
interface FooterColumn {
  label: string;
  links: Array<{ label: string; href: string }>;
}

interface Props {
  docs: {
    footer?: {
      columns?: FooterColumn[];
      copyright?: string;
    };
  };
}

const { docs } = Astro.props as Props;
const footer = docs.footer;
if (!footer) return null;
---
<footer class="nebula-footer">
  <div class="nebula-footer-inner">
    {footer.columns && footer.columns.length > 0 && (
      <div class="nebula-footer-columns">
        {footer.columns.map((column) => (
          <div class="nebula-footer-column">
            <h3>{column.label}</h3>
            <ul>
              {column.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
    {footer.copyright && (
      <p class="nebula-footer-copyright">{footer.copyright}</p>
    )}
  </div>
</footer>

<style>
  /* Full-width footer. Outer element spans the viewport (border-top runs
     edge to edge); inner is capped at the same 64rem container width as
     the custom-mode page shell so the columns line up with the rest of
     the site no matter which layout sits above. Columns are evenly
     distributed via `space-between`. */
  .nebula-footer {
    width: 100%;
    /* Sticky-footer: paired with `display: flex; flex-direction: column`
       on body. `auto` absorbs leftover vertical space when page content
       is shorter than the viewport, pinning the footer to the bottom. */
    margin-top: auto;
    background: var(--nebula-chrome-bg);
    border-top: 1px solid var(--mcoe-border-default);
    font-size: var(--mcoe-font-size-sm);
    color: var(--mcoe-text-secondary);
  }
  .nebula-footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    /* Top padding doubles as the visual breathing room between the
       footer's border-top and its content (the previous outer
       `margin-top` got replaced by `margin-top: auto` for the sticky
       behavior). */
    padding: var(--mcoe-space-8) 1.5rem var(--mcoe-space-7);
  }
  .nebula-footer-columns {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--mcoe-space-6) var(--mcoe-space-7);
  }
  .nebula-footer-column h3 {
    font-size: var(--mcoe-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mcoe-text-heading);
    margin: 0 0 var(--mcoe-space-3);
  }
  .nebula-footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nebula-footer-column li {
    margin: var(--mcoe-space-1) 0;
  }
  .nebula-footer-copyright {
    margin-top: var(--mcoe-space-5);
    color: var(--mcoe-text-secondary);
  }
</style>
