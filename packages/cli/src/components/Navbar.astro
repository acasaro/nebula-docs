---
import NebulaIcon from './NebulaIcon.astro';
import { activeTabIndex, tabHref, resolveIcon } from '../runtime/lib/nav.mjs';

interface Props {
  docs: any;
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props as Props;
const tabs = docs.navigation?.tabs ?? [];
const activeIdx = activeTabIndex(tabs, currentSlug);
const versions = docs.versions ?? [];
const currentVersion = versions.find((v: any) => v.default) ?? versions[0];

const logoHref = docs.logo?.href ?? '/';
const hasLogoImg = Boolean(docs.logo?.light || docs.logo?.dark);

const navbarLinks = docs.navbar?.links ?? [];
const primary = docs.navbar?.primary;
const showSecondaryRow = tabs.length > 0 || navbarLinks.length > 0 || primary;
---
<header class="nebula-navbar">
  <!-- Top utility row: brand + version + search/theme toggles -->
  <div class="nebula-navbar-row nebula-navbar-row--top">
    <div class="nebula-navbar-row-inner">
    <div class="nebula-navbar-brand">
      <a class="nebula-brand-link" href={logoHref} aria-label={`${docs.name} home`}>
        {hasLogoImg ? (
          <>
            {docs.logo?.light && (
              <img class="nebula-logo nebula-logo-light" src={docs.logo.light} alt={`${docs.name} logo`} />
            )}
            {docs.logo?.dark && (
              <img class="nebula-logo nebula-logo-dark" src={docs.logo.dark} alt={`${docs.name} logo`} />
            )}
          </>
        ) : (
          <span class="nebula-brand-name">{docs.name}</span>
        )}
      </a>
      {currentVersion && (
        <span class="nebula-version-pill" title={currentVersion.version}>
          {currentVersion.version}
        </span>
      )}
    </div>

    <div class="nebula-navbar-actions">
      <button type="button" class="nebula-search-btn" aria-label="Search docs">
        <NebulaIcon name="search" size={14} />
        <span class="nebula-search-placeholder">Search</span>
        <kbd class="nebula-kbd">⌘K</kbd>
      </button>
      <button
        type="button"
        class="nebula-icon-btn"
        aria-label="Toggle dark mode"
        data-nebula-theme-toggle
      >
        <span class="nebula-theme-icon-light"><NebulaIcon name="sun" size={16} /></span>
        <span class="nebula-theme-icon-dark"><NebulaIcon name="moon" size={16} /></span>
      </button>
    </div>
    </div>
  </div>

  <!-- Bottom row: tab navigation + secondary actions -->
  {showSecondaryRow && (
    <div class="nebula-navbar-row nebula-navbar-row--bottom">
    <div class="nebula-navbar-row-inner">
      <nav class="nebula-tabs" aria-label="Sections">
        {tabs.map((tab: any, i: number) => {
          const tabIcon = resolveIcon(tab.icon);
          const href = tabHref(tab);
          const isActive = i === activeIdx;
          return (
            <a
              class="nebula-tab"
              href={href}
              aria-current={isActive ? 'true' : undefined}
            >
              {tabIcon && (
                <NebulaIcon
                  name={tabIcon.name}
                  library={tabIcon.library}
                  type={tabIcon.type}
                  size={14}
                />
              )}
              <span>{tab.tab}</span>
            </a>
          );
        })}
      </nav>
      <div class="nebula-navbar-cta">
        {navbarLinks.map((link: any) => {
          const linkIcon = resolveIcon(link.icon);
          return (
            <a class="nebula-navbar-link" href={link.href}>
              {linkIcon && (
                <NebulaIcon
                  name={linkIcon.name}
                  library={linkIcon.library}
                  type={linkIcon.type}
                  size={14}
                />
              )}
              <span>{link.label}</span>
            </a>
          );
        })}
        {primary && (
          <a class="nebula-navbar-primary" href={primary.href}>
            {primary.label}
          </a>
        )}
      </div>
    </div>
    </div>
  )}
</header>

<script is:inline>
  // Theme toggle (Phase 1 stub): flips data-theme="dark" on <html> and
  // persists to localStorage. We default to "light" regardless of system
  // preference because the generated tokens.css only includes global dark
  // overrides — per-theme bg/surface dark overrides are applied by the
  // theme-switcher island that lands in Phase 3 (port of McoeThemeProvider).
  // Auto-applying dark from system pref would break colors until then.
  (function () {
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
    }
    var stored = localStorage.getItem('nebula-theme');
    applyTheme(stored === 'dark' ? 'dark' : 'light');
    document.querySelectorAll('[data-nebula-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        applyTheme(current);
        localStorage.setItem('nebula-theme', current);
      });
    });
  })();
</script>

<style is:global>
  .nebula-navbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--mcoe-bg-primary) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* Full-width row wrappers — borders stretch edge to edge. The inner
     container is what's max-width-capped and centered. */
  .nebula-navbar-row {
    width: 100%;
    border-bottom: 1px solid var(--mcoe-border-default);
  }
  .nebula-navbar-row--bottom {
    border-bottom: 1px solid var(--mcoe-border-default);
  }
  /* Navbar inner width tracks the page shell. Default matches `.nebula-shell`
     (1280px). When the layout opts into the TOC layout (`.nebula-shell.has-toc`,
     90rem wide), the body:has() rule below widens the navbar to match so
     the header content's left/right edges align with the page content. */
  .nebula-navbar-row-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  body:has(.nebula-shell.has-toc) .nebula-navbar-row-inner {
    max-width: 90rem;
  }
  .nebula-navbar-row--top .nebula-navbar-row-inner {
    height: 3.25rem;
  }
  .nebula-navbar-row--bottom .nebula-navbar-row-inner {
    height: 2.5rem;
  }
  .nebula-navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .nebula-brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--mcoe-text-heading);
    font-weight: 600;
    text-decoration: none;
  }
  .nebula-brand-link:hover {
    text-decoration: none;
  }
  .nebula-brand-name {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .nebula-logo {
    height: 1.5rem;
    width: auto;
    display: block;
  }
  [data-theme='dark'] .nebula-logo-light {
    display: none;
  }
  :root .nebula-logo-dark,
  :not([data-theme='dark']) .nebula-logo-dark {
    display: none;
  }
  [data-theme='dark'] .nebula-logo-dark {
    display: block;
  }
  .nebula-version-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--mcoe-text-heading) 6%, transparent);
    color: var(--mcoe-text-secondary);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: normal;
  }

  .nebula-navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nebula-search-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding: 0 0.5rem 0 0.625rem;
    border: 1px solid var(--mcoe-border-default);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--mcoe-text-heading) 3%, transparent);
    color: var(--mcoe-text-secondary);
    font-size: 0.8125rem;
    cursor: pointer;
    min-width: 12rem;
    transition: border-color 0.1s, background-color 0.1s;
  }
  .nebula-search-btn:hover {
    border-color: var(--mcoe-border-default);
    background: color-mix(in srgb, var(--mcoe-text-heading) 7%, transparent);
  }
  .nebula-search-placeholder {
    flex: 1;
    text-align: left;
  }
  .nebula-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.05rem 0.35rem;
    background: var(--mcoe-bg-primary);
    border: 1px solid var(--mcoe-border-default);
    border-radius: 0.3rem;
    font-family: var(--nebula-font-mono);
    font-size: 0.6875rem;
    color: var(--mcoe-text-secondary);
    line-height: 1.4;
  }
  .nebula-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--mcoe-text-secondary);
    cursor: pointer;
    transition: background-color 0.1s, color 0.1s;
  }
  .nebula-icon-btn:hover {
    background: color-mix(in srgb, var(--mcoe-text-heading) 6%, transparent);
    color: var(--mcoe-text-heading);
  }
  /* Theme-icon swap: show sun in dark mode (click → light), moon in light mode. */
  .nebula-theme-icon-dark {
    display: none;
  }
  :root .nebula-theme-icon-light,
  :not([data-theme='dark']) .nebula-theme-icon-light {
    display: inline-flex;
  }
  [data-theme='dark'] .nebula-theme-icon-light {
    display: none;
  }
  [data-theme='dark'] .nebula-theme-icon-dark {
    display: inline-flex;
  }

  /* Tabs row content */
  .nebula-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow-x: auto;
    height: 100%;
  }
  .nebula-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0 0.625rem;
    color: var(--mcoe-text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px; /* overlap parent border-bottom */
    white-space: nowrap;
    transition: color 0.1s, border-color 0.1s;
  }
  .nebula-tab:hover {
    color: var(--mcoe-text-heading);
    text-decoration: none;
  }
  .nebula-tab[aria-current='true'] {
    color: var(--mcoe-brand-primary);
    border-bottom-color: var(--mcoe-brand-primary);
  }

  .nebula-navbar-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Compact button variants — sized to sit comfortably in the 40px row.
     Smaller than the default Tailwind/shadcn `sm` button by a hair so the
     navbar still reads as utility-chrome rather than a full toolbar. */
  .nebula-navbar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.75rem;
    padding: 0 0.625rem;
    border: 1px solid var(--mcoe-border-default);
    border-radius: 0.4375rem;
    color: var(--mcoe-text-primary);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    transition: background-color 0.1s, border-color 0.1s;
  }
  .nebula-navbar-link:hover {
    background: color-mix(in srgb, var(--mcoe-text-heading) 4%, transparent);
    text-decoration: none;
  }
  .nebula-navbar-primary {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    padding: 0 0.75rem;
    border-radius: 0.4375rem;
    background: var(--mcoe-brand-primary);
    color: var(--mcoe-text-inverse);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    transition: background-color 0.1s;
  }
  .nebula-navbar-primary:hover {
    background: var(--mcoe-brand-primary-dark);
    color: var(--mcoe-text-inverse);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .nebula-search-btn {
      min-width: 0;
    }
    .nebula-search-placeholder,
    .nebula-kbd {
      display: none;
    }
    .nebula-navbar-row--bottom .nebula-navbar-row-inner {
      flex-direction: column;
      gap: 0;
      height: auto;
      padding: 0.25rem 1rem;
    }
    .nebula-navbar-cta {
      padding: 0.375rem 0;
      border-top: 1px solid var(--mcoe-border-default);
    }
  }
</style>
