---
import NebulaIcon from './NebulaIcon.astro';
import SidebarGroup from './SidebarGroup.astro';
import SidebarPageLink from './SidebarPageLink.astro';
import { activeTabIndex, isHidden, isGroup, resolveIcon } from '../runtime/lib/nav.mjs';

interface Props {
  docs: {
    navigation?: {
      tabs?: any[];
      pages?: any[];
      groups?: any[];
      anchors?: any[];
      dropdowns?: any[];
      global?: { anchors?: any[] };
    };
  };
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props as Props;
const tabs = docs.navigation?.tabs ?? [];
const rootPages = docs.navigation?.pages ?? [];
const rootGroups = docs.navigation?.groups ?? [];
const anchors = (docs.navigation?.anchors ?? []).filter((a: any) => !a.hidden);
const dropdowns = (docs.navigation?.dropdowns ?? []).filter(
  (d: any) => !d.hidden,
);
const globalAnchors = (docs.navigation?.global?.anchors ?? []).filter(
  (a: any) => !a.hidden,
);

// Tabs are now in the navbar; the sidebar only renders the *active* tab's
// groups. This mirrors Mintlify's pattern: switching tabs in the navbar
// switches the visible sidebar tree.
//
// When there are no tabs but root pages/groups are set (Mintlify allows
// root-level navigation without a tabs wrapper), render those instead.
const activeIdx = activeTabIndex(tabs, currentSlug);
const activeTab = tabs[activeIdx];
const activeGroups = activeTab?.groups ?? [];
const activeDirectPages = activeTab?.pages ?? [];
const activeMenu = (activeTab?.menu ?? []).filter((m: any) => !m.hidden);

// What the sidebar actually renders.
const visibleDirectPages = (
  tabs.length > 0 ? activeDirectPages : rootPages
).filter((p: any) => !isHidden(p));
const visibleGroups = tabs.length > 0 ? activeGroups : rootGroups;
const ariaLabel = activeTab?.tab ?? 'Documentation';
---
<nav class="nebula-sidebar" aria-label={ariaLabel}>
  <div class="nebula-sidebar-body">
    {/* Anchors — Mintlify "persistent items above the sidebar groups".
        Rendered with distinct iconography so they don't blend into the
        regular group/page hierarchy below. Each anchor is either a single
        external link or a collapsible holding nested pages/groups. */}
    {(anchors.length > 0 || globalAnchors.length > 0) && (
      <div class="nebula-sidebar-anchors">
        {[...anchors, ...globalAnchors].map((a: any) => {
          const icon = resolveIcon(a.icon);
          const label = a.anchor;
          if (a.href) {
            const isExt = /^https?:/i.test(a.href);
            return (
              <a
                class="nebula-sidebar-anchor-link"
                href={a.href}
                target={isExt ? '_blank' : undefined}
                rel={isExt ? 'noopener noreferrer' : undefined}
              >
                {icon && (
                  <NebulaIcon
                    name={icon.name}
                    library={icon.library}
                    type={icon.type}
                    size={14}
                  />
                )}
                <span>{label}</span>
              </a>
            );
          }
          // Anchor with nested content — render as a collapsible.
          const childPages = (a.pages ?? []).filter((p: any) => !isHidden(p));
          const childGroups = a.groups ?? [];
          return (
            <details class="nebula-sidebar-anchor" open>
              <summary class="nebula-sidebar-anchor-summary">
                {icon && (
                  <NebulaIcon
                    name={icon.name}
                    library={icon.library}
                    type={icon.type}
                    size={14}
                  />
                )}
                <span>{label}</span>
              </summary>
              {childPages.length > 0 && (
                <ul class="nebula-sidebar-list">
                  {childPages.map((page: any) =>
                    isGroup(page) ? (
                      <li class="nebula-sidebar-item">
                        <SidebarGroup group={page} currentSlug={currentSlug} />
                      </li>
                    ) : (
                      <SidebarPageLink page={page} currentSlug={currentSlug} />
                    ),
                  )}
                </ul>
              )}
              {childGroups.map((g: any) => (
                <SidebarGroup group={g} currentSlug={currentSlug} />
              ))}
            </details>
          );
        })}
      </div>
    )}

    {/* Dropdowns — same data shape as anchors, rendered as expandable
        sections. Per Mintlify these are visually distinct from anchors
        (more menu-like). For now we share the anchor render and class
        them differently so future styling can diverge. */}
    {dropdowns.length > 0 && (
      <div class="nebula-sidebar-dropdowns">
        {dropdowns.map((d: any) => {
          const icon = resolveIcon(d.icon);
          if (d.href) {
            const isExt = /^https?:/i.test(d.href);
            return (
              <a
                class="nebula-sidebar-anchor-link"
                href={d.href}
                target={isExt ? '_blank' : undefined}
                rel={isExt ? 'noopener noreferrer' : undefined}
              >
                {icon && (
                  <NebulaIcon
                    name={icon.name}
                    library={icon.library}
                    type={icon.type}
                    size={14}
                  />
                )}
                <span>{d.dropdown}</span>
              </a>
            );
          }
          const childPages = (d.pages ?? []).filter((p: any) => !isHidden(p));
          const childGroups = d.groups ?? [];
          return (
            <details class="nebula-sidebar-anchor">
              <summary class="nebula-sidebar-anchor-summary">
                {icon && (
                  <NebulaIcon
                    name={icon.name}
                    library={icon.library}
                    type={icon.type}
                    size={14}
                  />
                )}
                <span>{d.dropdown}</span>
              </summary>
              {childPages.length > 0 && (
                <ul class="nebula-sidebar-list">
                  {childPages.map((page: any) =>
                    isGroup(page) ? (
                      <li class="nebula-sidebar-item">
                        <SidebarGroup group={page} currentSlug={currentSlug} />
                      </li>
                    ) : (
                      <SidebarPageLink page={page} currentSlug={currentSlug} />
                    ),
                  )}
                </ul>
              )}
              {childGroups.map((g: any) => (
                <SidebarGroup group={g} currentSlug={currentSlug} />
              ))}
            </details>
          );
        })}
      </div>
    )}

    {visibleDirectPages.length > 0 && (
      <ul class="nebula-sidebar-list">
        {visibleDirectPages.map((page: any) =>
          isGroup(page) ? (
            <li class="nebula-sidebar-item">
              <SidebarGroup group={page} currentSlug={currentSlug} />
            </li>
          ) : (
            <SidebarPageLink page={page} currentSlug={currentSlug} />
          ),
        )}
      </ul>
    )}
    {visibleGroups.map((group: any) => (
      <SidebarGroup group={group} currentSlug={currentSlug} />
    ))}

    {/* Tab menu — Mintlify `tab.menu`. Each item is a labeled section
        holding nested pages/groups (or an external href). Rendered as
        top-level group-style sections within the active tab's sidebar. */}
    {activeMenu.map((m: any) => {
      const icon = resolveIcon(m.icon);
      if (m.href) {
        const isExt = /^https?:/i.test(m.href);
        return (
          <a
            class="nebula-sidebar-anchor-link"
            href={m.href}
            target={isExt ? '_blank' : undefined}
            rel={isExt ? 'noopener noreferrer' : undefined}
          >
            {icon && (
              <NebulaIcon
                name={icon.name}
                library={icon.library}
                type={icon.type}
                size={14}
              />
            )}
            <span>{m.item}</span>
          </a>
        );
      }
      const childPages = (m.pages ?? []).filter((p: any) => !isHidden(p));
      const childGroups = m.groups ?? [];
      return (
        <div class="nebula-sidebar-group">
          <p class="nebula-sidebar-group-title">
            {icon && (
              <NebulaIcon
                name={icon.name}
                library={icon.library}
                type={icon.type}
                size={14}
              />
            )}
            <span>{m.item}</span>
          </p>
          {m.description && (
            <p class="nebula-sidebar-menu-description">{m.description}</p>
          )}
          {childPages.length > 0 && (
            <ul class="nebula-sidebar-list">
              {childPages.map((page: any) =>
                isGroup(page) ? (
                  <li class="nebula-sidebar-item">
                    <SidebarGroup group={page} currentSlug={currentSlug} />
                  </li>
                ) : (
                  <SidebarPageLink page={page} currentSlug={currentSlug} />
                ),
              )}
            </ul>
          )}
          {childGroups.map((g: any) => (
            <SidebarGroup group={g} currentSlug={currentSlug} />
          ))}
        </div>
      );
    })}
  </div>
</nav>

<style is:global>
  .nebula-sidebar {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .nebula-sidebar-body > * + * {
    margin-top: 1.5rem;
  }

  /* Group title: pencil-icon style — same vertical rhythm as page links so
     the icon column stays aligned, but with heading color + medium weight. */
  .nebula-sidebar-group-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 0.375rem;
    padding: 0.4375rem 0.625rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mcoe-text-heading);
    text-transform: none;
    letter-spacing: -0.005em;
    line-height: 1.35;
  }

  .nebula-sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nebula-sidebar-item {
    margin: 0;
  }
  .nebula-sidebar-item a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4375rem 0.625rem;
    /* Inset to align text under the group title (icon column = 14px + 0.625rem gap). */
    padding-left: 1.875rem;
    border-radius: 0.5rem;
    color: var(--mcoe-text-secondary);
    font-size: 0.9375rem;
    font-weight: 450;
    line-height: 1.45;
    transition: color 0.1s, background-color 0.1s;
  }
  .nebula-sidebar-item a:hover {
    color: var(--mcoe-text-heading);
    text-decoration: none;
    background-color: color-mix(in srgb, var(--mcoe-text-heading) 5%, transparent);
  }
  /* Active item: brand-color pill. Hover keeps the neutral gray so a non-active
     item temporarily-hovered doesn't read as the current page. */
  .nebula-sidebar-item a[aria-current='page'] {
    color: var(--mcoe-brand-primary);
    background-color: color-mix(in srgb, var(--mcoe-brand-primary) 10%, transparent);
    font-weight: 500;
  }
  .nebula-sidebar-item a[aria-current='page']:hover {
    background-color: color-mix(in srgb, var(--mcoe-brand-primary) 14%, transparent);
  }
  .nebula-sidebar-tag {
    margin-left: auto;
    padding: 0.05rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--mcoe-brand-primary);
    background: color-mix(in srgb, var(--mcoe-brand-primary) 10%, transparent);
    line-height: 1.2;
  }

  /* `group.root` link rendered inside the group title. Styled to look like
     plain title text by default, with a hover that hints at clickability and
     an active state when the user is currently on the root page. */
  .nebula-sidebar-group-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.1s;
  }
  .nebula-sidebar-group-title-link:hover {
    color: var(--mcoe-brand-primary);
    text-decoration: none;
  }
  .nebula-sidebar-group-title-link[aria-current='page'] {
    color: var(--mcoe-brand-primary);
  }

  /* Anchors / Dropdowns — persistent items above the regular sidebar
     content. Distinct visual: pill-shaped clickable rows with icons that
     read as "shortcuts" not docs hierarchy. */
  .nebula-sidebar-anchors,
  .nebula-sidebar-dropdowns {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--mcoe-text-heading) 8%, transparent);
  }
  .nebula-sidebar-anchor-link,
  .nebula-sidebar-anchor-summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4375rem 0.625rem;
    border-radius: 0.5rem;
    color: var(--mcoe-text-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.1s, background-color 0.1s;
  }
  .nebula-sidebar-anchor-summary::-webkit-details-marker {
    display: none;
  }
  .nebula-sidebar-anchor-link:hover,
  .nebula-sidebar-anchor-summary:hover {
    color: var(--mcoe-brand-primary);
    text-decoration: none;
    background-color: color-mix(in srgb, var(--mcoe-brand-primary) 6%, transparent);
  }
  .nebula-sidebar-anchor[open] > .nebula-sidebar-anchor-summary {
    color: var(--mcoe-brand-primary);
  }
  .nebula-sidebar-menu-description {
    margin: 0 0 0.5rem 1.875rem;
    font-size: 0.8125rem;
    color: var(--mcoe-text-secondary);
    line-height: 1.45;
  }

  /* Nested sub-groups render as a collapsible button + indented list using
     <details>. The chevron rotates 90deg when [open]. */
  .nebula-sidebar-nested {
    margin: 0;
  }
  .nebula-sidebar-nested-summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4375rem 0.625rem;
    padding-left: 1.875rem;
    border-radius: 0.5rem;
    color: var(--mcoe-text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .nebula-sidebar-nested-summary::-webkit-details-marker {
    display: none;
  }
  .nebula-sidebar-nested-summary:hover {
    color: var(--mcoe-text-heading);
    background-color: color-mix(in srgb, var(--mcoe-text-heading) 4%, transparent);
  }
  .nebula-sidebar-nested-chevron {
    margin-left: auto;
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 0.15s;
  }
  .nebula-sidebar-nested[open] > .nebula-sidebar-nested-summary .nebula-sidebar-nested-chevron {
    transform: rotate(90deg);
  }
  .nebula-sidebar-nested .nebula-sidebar-list {
    margin-left: 0.625rem;
  }
  .nebula-sidebar-nested .nebula-sidebar-item a {
    padding-left: 2.5rem;
  }
</style>
