---
import SidebarGroup from './SidebarGroup.astro';
import NebulaIcon from './NebulaIcon.astro';
import { resolveIcon } from '../runtime/lib/nav.mjs';

interface Props {
  docs: { navigation?: { tabs?: any[] } };
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props as Props;
const tabs = docs.navigation?.tabs ?? [];
---
<nav class="nebula-sidebar" aria-label="Documentation">
  {tabs.map((tab) => {
    const tabIcon = resolveIcon(tab.icon);
    return (
      <div class="nebula-sidebar-tab">
        <h2 class="nebula-sidebar-tab-title">
          {tabIcon && (
            <NebulaIcon
              name={tabIcon.name}
              library={tabIcon.library}
              type={tabIcon.type}
              size={14}
            />
          )}
          <span>{tab.tab}</span>
        </h2>
        {(tab.groups ?? []).map((group: any) => (
          <SidebarGroup group={group} currentSlug={currentSlug} />
        ))}
      </div>
    );
  })}
</nav>

<style is:global>
  .nebula-sidebar {
    font-size: var(--mcoe-font-size-sm);
  }
  .nebula-sidebar-tab + .nebula-sidebar-tab {
    margin-top: var(--mcoe-space-7);
  }
  .nebula-sidebar-tab-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--mcoe-font-size-xs);
    color: var(--mcoe-text-secondary);
    margin: 0 0 var(--mcoe-space-3);
    font-weight: var(--mcoe-font-weight-bold);
  }
  .nebula-sidebar-group + .nebula-sidebar-group {
    margin-top: var(--mcoe-space-5);
  }
  .nebula-sidebar-group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--mcoe-font-weight-medium);
    color: var(--mcoe-text-heading);
    margin: var(--mcoe-space-3) 0 var(--mcoe-space-2);
    font-size: var(--mcoe-font-size-xs);
    text-transform: capitalize;
    letter-spacing: normal;
  }
  .nebula-sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nebula-sidebar-item {
    margin: 0;
  }
  .nebula-sidebar-item a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    margin-left: -0.75rem;
    border-radius: 0.5rem;
    color: var(--mcoe-text-secondary);
    line-height: 1.4;
    transition: color 0.1s, background-color 0.1s;
  }
  .nebula-sidebar-item a:hover {
    color: var(--mcoe-text-heading);
    text-decoration: none;
    background-color: color-mix(in srgb, var(--mcoe-text-heading) 4%, transparent);
  }
  /* Active state matches Mintlify's pattern: brand-color text + a thin
     text-shadow that fakes bolder weight without layout shift. */
  .nebula-sidebar-item a[aria-current='page'] {
    color: var(--mcoe-brand-primary);
    text-shadow:
      -0.2px 0 0 currentColor,
      0.2px 0 0 currentColor;
    background-color: color-mix(in srgb, var(--mcoe-brand-primary) 8%, transparent);
  }
  .nebula-sidebar-tag {
    margin-left: auto;
    padding: 0.05rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.65rem;
    font-weight: var(--mcoe-font-weight-bold);
    color: var(--mcoe-brand-primary);
    background: color-mix(in srgb, var(--mcoe-brand-primary) 10%, transparent);
    line-height: 1.2;
  }
  .nebula-sidebar-nested {
    margin-left: 0.75rem;
  }
  .nebula-sidebar-nested .nebula-sidebar-group-title {
    text-transform: none;
    color: var(--mcoe-text-primary);
    font-size: var(--mcoe-font-size-sm);
  }
</style>
