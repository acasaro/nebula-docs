---
import NebulaIcon from './NebulaIcon.astro';
import SidebarPageLink from './SidebarPageLink.astro';
import { isGroup, resolveIcon, isHidden } from '../runtime/lib/nav.mjs';

interface Props {
  group: any;
  currentSlug: string;
  depth?: number;
}

const { group, currentSlug, depth = 0 } = Astro.props as Props;
const groupIcon = resolveIcon(group.icon);
const isTopLevel = depth === 0;

// Whether a nested group should default to expanded. Open if the current
// page lives inside it, or if the author set `expanded: true` in docs.json.
function containsSlug(g: any, slug: string): boolean {
  for (const p of g.pages ?? []) {
    if (typeof p === 'string') {
      if (p === slug) return true;
    } else if (p && typeof p === 'object') {
      if ('group' in p && containsSlug(p, slug)) return true;
      if ((p.slug || p.page) === slug) return true;
    }
  }
  return false;
}
const nestedOpen = !isTopLevel && (group.expanded || containsSlug(group, currentSlug));
const visiblePages = (group.pages ?? []).filter((p: any) => !isHidden(p));
---
{isTopLevel ? (
  <div class="nebula-sidebar-group">
    <p class="nebula-sidebar-group-title">
      {groupIcon && (
        <NebulaIcon
          name={groupIcon.name}
          library={groupIcon.library}
          type={groupIcon.type}
          size={14}
        />
      )}
      <span>{group.group}</span>
    </p>
    <ul class="nebula-sidebar-list">
      {visiblePages.map((page: any) =>
        isGroup(page) ? (
          <li class="nebula-sidebar-item">
            <Astro.self group={page} currentSlug={currentSlug} depth={depth + 1} />
          </li>
        ) : (
          <SidebarPageLink page={page} currentSlug={currentSlug} />
        ),
      )}
    </ul>
  </div>
) : (
  <details class="nebula-sidebar-nested" open={nestedOpen}>
    <summary class="nebula-sidebar-nested-summary">
      {groupIcon && (
        <NebulaIcon
          name={groupIcon.name}
          library={groupIcon.library}
          type={groupIcon.type}
          size={14}
        />
      )}
      <span>{group.group}</span>
      <svg
        class="nebula-sidebar-nested-chevron"
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m4.5 3 3 3-3 3"></path>
      </svg>
    </summary>
    <ul class="nebula-sidebar-list">
      {visiblePages.map((page: any) =>
        isGroup(page) ? (
          <li class="nebula-sidebar-item">
            <Astro.self group={page} currentSlug={currentSlug} depth={depth + 1} />
          </li>
        ) : (
          <SidebarPageLink page={page} currentSlug={currentSlug} />
        ),
      )}
    </ul>
  </details>
)}
