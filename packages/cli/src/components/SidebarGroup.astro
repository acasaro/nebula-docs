---
import NebulaIcon from './NebulaIcon.astro';
import SidebarPageLink from './SidebarPageLink.astro';
import { isGroup, resolveIcon, isHidden } from '../runtime/lib/nav.mjs';

interface Props {
  group: any;
  currentSlug: string;
  depth?: number;
}

const { group, currentSlug, depth = 0 } = Astro.props as Props;
const groupIcon = resolveIcon(group.icon);
const isTopLevel = depth === 0;

// Whether a nested group should default to expanded. Open if the current
// page lives inside it, or if the author set `expanded: true` in docs.json.
function containsSlug(g: any, slug: string): boolean {
  for (const p of g.pages ?? []) {
    if (typeof p === 'string') {
      if (p === slug) return true;
    } else if (p && typeof p === 'object') {
      if ('group' in p && containsSlug(p, slug)) return true;
      if ((p.slug || p.page) === slug) return true;
    }
  }
  return false;
}
const nestedOpen = !isTopLevel && (group.expanded || containsSlug(group, currentSlug));
const visiblePages = (group.pages ?? []).filter((p: any) => !isHidden(p));

// Mintlify `group.root`: when set, the group title navigates to that page
// instead of being plain text. We render the title as an `<a>` and let the
// platform style it like a regular link. For nested groups (details/summary)
// the click bubble would also toggle the disclosure — an `is:inline` script
// at the bottom of this file stops that bubble so the click is purely a
// navigation.
const rootHref =
  typeof group.root === 'string' && group.root.length > 0
    ? group.root === 'index'
      ? '/'
      : `/${group.root}`
    : null;
const groupTag = typeof group.tag === 'string' && group.tag.trim() ? group.tag.trim() : null;
---
{isTopLevel ? (
  <div class="nebula-sidebar-group">
    <p class="nebula-sidebar-group-title">
      {groupIcon && (
        <NebulaIcon
          name={groupIcon.name}
          library={groupIcon.library}
          type={groupIcon.type}
          size={14}
        />
      )}
      {rootHref ? (
        <a class="nebula-sidebar-group-title-link" href={rootHref} aria-current={currentSlug === group.root ? 'page' : undefined}>
          {group.group}
        </a>
      ) : (
        <span>{group.group}</span>
      )}
      {groupTag && <span class="nebula-sidebar-tag">{groupTag}</span>}
    </p>
    <ul class="nebula-sidebar-list">
      {visiblePages.map((page: any) =>
        isGroup(page) ? (
          <li class="nebula-sidebar-item">
            <Astro.self group={page} currentSlug={currentSlug} depth={depth + 1} />
          </li>
        ) : (
          <SidebarPageLink page={page} currentSlug={currentSlug} />
        ),
      )}
    </ul>
  </div>
) : (
  <details class="nebula-sidebar-nested" open={nestedOpen}>
    <summary class="nebula-sidebar-nested-summary">
      {groupIcon && (
        <NebulaIcon
          name={groupIcon.name}
          library={groupIcon.library}
          type={groupIcon.type}
          size={14}
        />
      )}
      {rootHref ? (
        <a
          class="nebula-sidebar-group-title-link"
          href={rootHref}
          data-stop-toggle
          aria-current={currentSlug === group.root ? 'page' : undefined}
        >
          {group.group}
        </a>
      ) : (
        <span>{group.group}</span>
      )}
      {groupTag && <span class="nebula-sidebar-tag">{groupTag}</span>}
      <svg
        class="nebula-sidebar-nested-chevron"
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m4.5 3 3 3-3 3"></path>
      </svg>
    </summary>
    <ul class="nebula-sidebar-list">
      {visiblePages.map((page: any) =>
        isGroup(page) ? (
          <li class="nebula-sidebar-item">
            <Astro.self group={page} currentSlug={currentSlug} depth={depth + 1} />
          </li>
        ) : (
          <SidebarPageLink page={page} currentSlug={currentSlug} />
        ),
      )}
    </ul>
  </details>
)}

<script is:inline>
  // Stop a click on a nested-group's root link from bubbling up to the
  // <summary>, which would otherwise toggle the <details> disclosure on top
  // of the navigation. Top-level groups don't need this (no <details>).
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target instanceof Element && target.closest('[data-stop-toggle]')) {
      e.stopPropagation();
    }
  }, true);
</script>
