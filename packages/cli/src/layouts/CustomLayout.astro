---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../runtime/components/Lightbox.astro';
import { loadDocsConfig } from '../runtime/lib/loadDocsConfig.mjs';

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  /** Per-page light-mode bg override. Falls through to the theme default if omitted. */
  backgroundColor?: string;
  /** Per-page dark-mode bg override. Falls through to the theme default if omitted. */
  backgroundColorDark?: string;
}

const { title, description, currentSlug, backgroundColor, backgroundColorDark } =
  Astro.props as Props;
const docs = loadDocsConfig();

// Inline-style each override as a CSS custom property on <body>. The static
// CSS in this layout's <style is:global> block reads these vars and applies
// them only in the matching theme (light vs dark) — so an unset side falls
// back to the theme default rather than leaking the other side's color.
const bodyStyleParts: string[] = [];
if (backgroundColor) bodyStyleParts.push(`--page-bg-light: ${backgroundColor}`);
if (backgroundColorDark) bodyStyleParts.push(`--page-bg-dark: ${backgroundColorDark}`);
const bodyStyle = bodyStyleParts.length > 0 ? bodyStyleParts.join('; ') : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {docs.name}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('nebula-theme');
          var theme = stored === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body style={bodyStyle}>
    <Navbar docs={docs} currentSlug={currentSlug} />
    <main class="nebula-custom-shell">
      <div class="nebula-custom-container mdx-prose">
        <slot />
      </div>
    </main>
    <Footer docs={docs} />
    <Lightbox />
    <script is:inline>
      (function () {
        var COPY = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
        var CHECK = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        function attach(pre) {
          if (pre.dataset.nebulaCopyInit === '1') return;
          pre.dataset.nebulaCopyInit = '1';
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'nebula-code-copy';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY;
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var text = pre.textContent || '';
            if (pre.hasAttribute('data-filename')) {
              text = text.replace(pre.getAttribute('data-filename'), '').replace(/^\n+/, '');
            }
            (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject())
              .then(function () {
                btn.dataset.copied = 'true';
                btn.innerHTML = CHECK;
                setTimeout(function () {
                  btn.dataset.copied = 'false';
                  btn.innerHTML = COPY;
                }, 1500);
              })
              .catch(function () {});
          });
          pre.appendChild(btn);
        }
        function run() {
          document.querySelectorAll('pre.astro-code').forEach(attach);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', run);
        } else {
          run();
        }
      })();
    </script>
    <style is:global>
      /* Custom-mode page shell. The shell is full-viewport-width; the inner
         `.nebula-custom-container` constrains regular content to a centered
         max-width column. Components that want full-bleed (Hero,
         marketing-style sections) opt out by setting
         `data-fullbleed` on their root element — the rule below forces them
         to span the viewport via the negative-margin trick, while keeping
         their internal centered alignment intact. */
      .nebula-custom-shell {
        width: 100%;
      }
      /* Per-page background override. Each rule is gated by the active theme
         so a one-sided override (only light, or only dark) leaves the other
         side falling through to the theme default rather than painting it
         the wrong color. `:where()` keeps specificity equal to the body's
         attribute selector, so source order tie-breaks. */
      :where(:root:not([data-theme="dark"]):not(.dark)) body[style*="--page-bg-light"] {
        background: var(--page-bg-light);
      }
      :where(:root[data-theme="dark"], :root.dark) body[style*="--page-bg-dark"] {
        background: var(--page-bg-dark);
      }
      .nebula-custom-container {
        max-width: 64rem;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
      }
      /* Full-bleed escape hatch. A direct child of `.nebula-custom-container`
         tagged with `data-fullbleed` breaks out to viewport width while
         staying in document flow. Components that own their internal
         centering (Hero) use this; their inner wrapper re-applies the same
         80rem container so content stays aligned with the rest of the page.
         The second selector handles components rendered as Astro client
         islands — `<astro-island>` sits between the container and the
         section, and `display: contents` (in global.css) makes it
         transparent to layout but NOT to CSS combinators, so we have to
         match through it explicitly. */
      .nebula-custom-container > [data-fullbleed],
      .nebula-custom-container > astro-island > [data-fullbleed] {
        width: 100vw;
        margin-inline: calc(50% - 50vw);
        max-width: none;
      }
    </style>
  </body>
</html>
