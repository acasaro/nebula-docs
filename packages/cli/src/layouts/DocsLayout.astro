---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { loadDocsConfig } from '../runtime/lib/loadDocsConfig.mjs';

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
}

const { title, description, currentSlug } = Astro.props as Props;
const docs = loadDocsConfig();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {docs.name}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Navbar docs={docs} />
    <div class="nebula-shell">
      <aside class="nebula-aside">
        <Sidebar docs={docs} currentSlug={currentSlug} />
      </aside>
      <main class="nebula-main">
        <article class="nebula-prose">
          <slot />
        </article>
        <Footer docs={docs} />
      </main>
    </div>
    <style>
      .nebula-shell {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        max-width: 1280px;
        margin: 0 auto;
        gap: var(--mcoe-space-7);
        padding: var(--mcoe-space-6);
      }
      .nebula-aside {
        position: sticky;
        top: var(--mcoe-space-6);
        align-self: start;
        max-height: calc(100vh - var(--mcoe-space-7));
        overflow-y: auto;
      }
      .nebula-main {
        min-width: 0;
        padding-bottom: var(--mcoe-space-9);
      }
      @media (max-width: 900px) {
        .nebula-shell {
          grid-template-columns: 1fr;
        }
        .nebula-aside {
          position: static;
          max-height: none;
        }
      }
    </style>
  </body>
</html>
