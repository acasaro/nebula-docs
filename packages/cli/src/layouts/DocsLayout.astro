---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TocSidebar from '../components/TocSidebar.astro';
import { loadDocsConfig, findGroupForSlug } from '../runtime/lib/loadDocsConfig.mjs';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  headings?: Heading[];
}

const { title, description, currentSlug, headings = [] } = Astro.props as Props;
const docs = loadDocsConfig();
const eyebrow = findGroupForSlug(docs, currentSlug);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {docs.name}</title>
    {description && <meta name="description" content={description} />}
    {/*
      Sync theme read BEFORE first paint — without this, the page paints
      with the default light tokens, then the Navbar's script (lower in
      the body) reads localStorage and flips `data-theme="dark"`, causing
      a white flash on every navigation. This blocking inline script in
      `<head>` runs before the body renders, so the correct theme is set
      before any paint. Also runs `color-scheme` so native form controls
      and the browser's own scrollbars match.
     */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('nebula-theme');
          var theme = stored === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          /* localStorage may be unavailable (e.g. embedded iframe) — fall
             through to the default light theme already implied by the
             absence of the data-theme attribute. */
        }
      })();
    </script>
  </head>
  <body>
    <Navbar docs={docs} currentSlug={currentSlug} />
    <div class={`nebula-shell ${hasToc ? 'has-toc' : ''}`}>
      <aside class="nebula-aside">
        <Sidebar docs={docs} currentSlug={currentSlug} />
      </aside>
      <main class="nebula-main">
        <article>
          <header class="nebula-page-header">
            {eyebrow && <p class="nebula-eyebrow">{eyebrow}</p>}
            <h1 class="nebula-page-title">{title}</h1>
            {description && (
              <p class="nebula-page-description">{description}</p>
            )}
          </header>
          <div class="mdx-prose">
            <slot />
          </div>
        </article>
        <Footer docs={docs} />
      </main>
      {hasToc && (
        <aside class="nebula-toc-aside">
          <TocSidebar headings={headings} />
        </aside>
      )}
    </div>
    {/* Copy-to-clipboard button on every fenced code block. Walks
        `.astro-code` pres after render and appends a button child;
        CSS in global.css positions it absolute top-right (over the
        filename chip when present, over the code area when not). */}
    <script is:inline>
      (function () {
        var COPY = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
        var CHECK = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        function attach(pre) {
          if (pre.dataset.nebulaCopyInit === '1') return;
          pre.dataset.nebulaCopyInit = '1';
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'nebula-code-copy';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY;
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var text = pre.textContent || '';
            // Strip the filename chip (rendered via ::before) — it isn't in
            // textContent, so this is a noop today, but keeps the contract
            // explicit if the chip ever moves into the DOM.
            if (pre.hasAttribute('data-filename')) {
              text = text.replace(pre.getAttribute('data-filename'), '').replace(/^\n+/, '');
            }
            (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject())
              .then(function () {
                btn.dataset.copied = 'true';
                btn.innerHTML = CHECK;
                setTimeout(function () {
                  btn.dataset.copied = 'false';
                  btn.innerHTML = COPY;
                }, 1500);
              })
              .catch(function () {});
          });
          pre.appendChild(btn);
        }
        function run() {
          document.querySelectorAll('pre.astro-code').forEach(attach);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', run);
        } else {
          run();
        }
      })();
    </script>
    <style>
      /* Three-column layout when there's a TOC, two-column otherwise. The
         right rail is fixed-width (12rem) like the left, so the article column
         (`.nebula-main`) flexes between them. The 5rem gap matches the
         left-side gap so the article reads as the centered focus column. */
      .nebula-shell {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr);
        max-width: 1280px;
        margin: 0 auto;
        gap: 4rem;
        padding: 1.5rem 2rem;
      }
      .nebula-shell.has-toc {
        grid-template-columns: 16rem minmax(0, 1fr) 12rem;
        gap: 4rem 5rem;
        max-width: 90rem;
      }
      /* Sticky offset = navbar (top row 53px + bottom row 41px = 94px) +
         24px breathing room. The Navbar is the sticky element above us, so
         our sticky top has to clear it; otherwise the asides hide behind it
         and only their bottom slice is visible. */
      .nebula-aside,
      .nebula-toc-aside {
        position: sticky;
        top: calc(94px + 1.5rem);
        align-self: start;
        max-height: calc(100vh - 94px - 3rem);
        overflow-y: auto;
      }
      .nebula-aside {
        padding-right: 1rem;
      }
      .nebula-main {
        min-width: 0;
        max-width: 48rem;
        padding-bottom: 4rem;
      }
      @media (max-width: 1180px) {
        .nebula-shell.has-toc {
          grid-template-columns: 16rem minmax(0, 1fr);
        }
        .nebula-toc-aside {
          display: none;
        }
      }
      @media (max-width: 900px) {
        .nebula-shell {
          grid-template-columns: 1fr;
        }
        .nebula-aside {
          position: static;
          max-height: none;
        }
      }
    </style>
  </body>
</html>
