---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TocSidebar from '../components/TocSidebar.astro';
import Lightbox from '../runtime/components/Lightbox.astro';
import SearchIsland from '../runtime/search/SearchIsland.astro';
import AnalyticsBootstrap from '../runtime/analytics/AnalyticsBootstrap.astro';
import {
  loadDocsConfig,
  findGroupForSlug,
  findBreadcrumbsForSlug,
} from '../runtime/lib/loadDocsConfig.mjs';
import { tabContainsSlug, withBase } from '../runtime/lib/nav.mjs';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  headings?: Heading[];
  /** Per-page light-mode bg override. Falls through to the theme default if omitted. */
  backgroundColor?: string;
  /** Per-page dark-mode bg override. Falls through to the theme default if omitted. */
  backgroundColorDark?: string;
}

const {
  title,
  description,
  currentSlug,
  headings = [],
  backgroundColor,
  backgroundColorDark,
} = Astro.props as Props;

// Inline-style each override as a CSS custom property on <body>. The static
// CSS in this layout's <style is:global> block reads these vars and applies
// them only in the matching theme (light vs dark) — so an unset side falls
// back to the theme default rather than leaking the other side's color.
const bodyStyleParts: string[] = [];
if (backgroundColor) bodyStyleParts.push(`--page-bg-light: ${backgroundColor}`);
if (backgroundColorDark) bodyStyleParts.push(`--page-bg-dark: ${backgroundColorDark}`);
const bodyStyle = bodyStyleParts.length > 0 ? bodyStyleParts.join('; ') : undefined;
const docs = loadDocsConfig();

// The active tab is stamped onto the article as `data-pagefind-meta="tab:..."`
// so the Pagefind index carries which tab each page belongs to. The search
// modal reads `result.meta.tab` to group results by tab when scopeBy="tab".
const activeTab = (docs.navigation?.tabs ?? []).find((t: any) =>
  tabContainsSlug(t, currentSlug),
);
const tabLabel = activeTab?.tab ?? '';
const searchConfig = docs.search ?? null;
const searchScopeBy = (searchConfig?.scopeBy ?? 'tab') as 'tab' | 'page' | 'none';
const siteBase = (import.meta.env.BASE_URL as string) || '/';

// Eyebrow rendering — Mintlify `styling.eyebrows`. `"section"` (default)
// shows the deepest group's name; `"breadcrumbs"` shows the full nav path
// from tab → group → subgroup. When unset, we use the current "section"
// behavior so existing tenants don't change.
const eyebrowMode = docs.styling?.eyebrows ?? 'section';
const breadcrumbs =
  eyebrowMode === 'breadcrumbs' ? findBreadcrumbsForSlug(docs, currentSlug) : [];
const sectionEyebrow =
  eyebrowMode === 'breadcrumbs' ? null : findGroupForSlug(docs, currentSlug);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {docs.name}</title>
    {description && <meta name="description" content={description} />}
    {/*
      Sync theme read BEFORE first paint — without this, the page paints
      with the default light tokens, then the Navbar's script (lower in
      the body) reads localStorage and flips `data-theme="dark"`, causing
      a white flash on every navigation. This blocking inline script in
      `<head>` runs before the body renders, so the correct theme is set
      before any paint. Also runs `color-scheme` so native form controls
      and the browser's own scrollbars match.
     */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('nebula-theme');
          var theme = stored === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          /* localStorage may be unavailable (e.g. embedded iframe) — fall
             through to the default light theme already implied by the
             absence of the data-theme attribute. */
        }
      })();
    </script>
  </head>
  <body style={bodyStyle}>
    <Navbar docs={docs} currentSlug={currentSlug} />
    <div class="nebula-shell">
      <aside class="nebula-aside">
        <Sidebar docs={docs} currentSlug={currentSlug} />
      </aside>
      <div class="nebula-content-area">
        <main class="nebula-main">
          <article
            data-pagefind-body={searchConfig ? '' : undefined}
            data-pagefind-meta={searchConfig && tabLabel ? `tab:${tabLabel}` : undefined}
          >
            <header class="nebula-page-header">
              {sectionEyebrow && <p class="nebula-eyebrow">{sectionEyebrow}</p>}
              {breadcrumbs.length > 0 && (
                <nav class="nebula-eyebrow nebula-breadcrumbs" aria-label="Breadcrumbs">
                  {breadcrumbs.map((b: any, i: number) => (
                    <>
                      {i > 0 && <span class="nebula-breadcrumb-sep" aria-hidden="true">›</span>}
                      {b.href ? (
                        <a class="nebula-breadcrumb-link" href={withBase(b.href, siteBase)}>{b.label}</a>
                      ) : (
                        <span>{b.label}</span>
                      )}
                    </>
                  ))}
                </nav>
              )}
              <h1 class="nebula-page-title">{title}</h1>
              {description && (
                <p class="nebula-page-description">{description}</p>
              )}
            </header>
            <div class="mdx-prose">
              <slot />
            </div>
          </article>
        </main>
        {hasToc && (
          <aside class="nebula-toc-aside">
            <TocSidebar headings={headings} />
          </aside>
        )}
      </div>
    </div>
    <Footer docs={docs} />
    <Lightbox />
    {searchConfig && <SearchIsland scopeBy={searchScopeBy} base={siteBase} />}
    <AnalyticsBootstrap />
    {/* Copy-to-clipboard button on every fenced code block. Walks
        `.astro-code` pres after render and appends a button child;
        CSS in global.css positions it absolute top-right (over the
        filename chip when present, over the code area when not). */}
    <script is:inline>
      (function () {
        var COPY = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
        var CHECK = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        function attach(pre) {
          if (pre.dataset.nebulaCopyInit === '1') return;
          pre.dataset.nebulaCopyInit = '1';
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'nebula-code-copy';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY;
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var text = pre.textContent || '';
            // Strip the filename chip (rendered via ::before) — it isn't in
            // textContent, so this is a noop today, but keeps the contract
            // explicit if the chip ever moves into the DOM.
            if (pre.hasAttribute('data-filename')) {
              text = text.replace(pre.getAttribute('data-filename'), '').replace(/^\n+/, '');
            }
            (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject())
              .then(function () {
                btn.dataset.copied = 'true';
                btn.innerHTML = CHECK;
                setTimeout(function () {
                  btn.dataset.copied = 'false';
                  btn.innerHTML = COPY;
                }, 1500);
              })
              .catch(function () {});
          });
          pre.appendChild(btn);
        }
        function run() {
          document.querySelectorAll('pre.astro-code').forEach(attach);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', run);
        } else {
          run();
        }
      })();
    </script>
    <style is:global>
      /* Per-page background override. Each rule is gated by the active
         theme so a one-sided override (only light, or only dark) leaves
         the other side falling through to the theme default rather than
         painting it the wrong color. `:where()` keeps specificity equal
         to the body's attribute selector, so source order tie-breaks. */
      :where(:root:not([data-theme="dark"]):not(.dark)) body[style*="--page-bg-light"] {
        background: var(--page-bg-light);
      }
      :where(:root[data-theme="dark"], :root.dark) body[style*="--page-bg-dark"] {
        background: var(--page-bg-dark);
      }
    </style>
    <style>
      /* Full-width shell — sidebar pinned to the left, article + TOC live
         inside `.nebula-content-area` and are centered as a group within
         the remaining viewport. */
      .nebula-shell {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 4rem;
        padding: 1.5rem 2rem;
      }
      /* Sticky offset = navbar (top row 56px + bottom row 44px = 100px) +
         24px breathing room. The Navbar is the sticky element above us, so
         our sticky top has to clear it; otherwise the asides hide behind it
         and only their bottom slice is visible. */
      .nebula-aside,
      .nebula-toc-aside {
        position: sticky;
        top: calc(100px + 1.5rem);
        align-self: flex-start;
        max-height: calc(100vh - 100px - 3rem);
        overflow-y: auto;
      }
      .nebula-aside {
        padding-right: 1rem;
        align-self: start;
      }
      .nebula-content-area {
        display: flex;
        align-items: flex-start;
        gap: 5rem;
        min-width: 0;
      }
      /* Article column. The `margin-left` calc centers `.nebula-main` on the
         viewport (50vw - half its own width) and subtracts the sidebar's
         offset-from-viewport (16rem sidebar + 2rem shell padding + 4rem gap
         = 22rem) since `.nebula-main` is positioned relative to the
         content-area, not the viewport. Below the calc breakpoint the result
         clamps to 0 and the article falls back to the start of the content
         area. Width chosen so 60–80 char prose lines hit at a 16px body
         font-size — the comfortable-reading sweet spot. */
      .nebula-main {
        flex: 0 1 auto;
        width: 100%;
        max-width: 880px;
        min-width: 0;
        margin-left: max(0px, calc(50vw - 440px - 22rem));
        padding: 1.5rem 1.5rem 4rem;
      }
      .nebula-main .mdx-prose {
        letter-spacing: -0.0125rem;
      }
      .nebula-toc-aside {
        flex: 0 0 12rem;
      }
      /* TOC needs sidebar(20rem) + main(880px) + gap(5rem) + toc(12rem) +
         right-padding(2rem) = ~1500px to fit without overflow. Hide it
         below that. */
      @media (max-width: 1500px) {
        .nebula-toc-aside {
          display: none;
        }
      }
      @media (max-width: 900px) {
        .nebula-shell {
          grid-template-columns: 1fr;
        }
        .nebula-aside {
          position: static;
          max-height: none;
        }
        .nebula-main {
          margin-left: 0;
        }
      }
    </style>
  </body>
</html>
