---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import { components as reactComponents } from '../runtime/components';
import Steps from '../runtime/components/Steps.astro';
import Step from '../runtime/components/Step.astro';
import Tabs from '../runtime/components/Tabs.astro';
import Tab from '../runtime/components/Tab.astro';
import Mermaid from '../runtime/components/Mermaid.astro';
import Hero from '../runtime/components/Hero.astro';
import TreeRoot from '../runtime/components/Tree.astro';
import TreeFolder from '../runtime/components/TreeFolder.astro';
import TreeFile from '../runtime/components/TreeFile.astro';
import CodeGroup from '../runtime/components/CodeGroup.astro';

// Namespace shape for MDX dotted-name resolution: <Tree.Folder> resolves to
// `components.Tree.Folder`, so the `Tree` entry must be a function-like
// object with `.Folder` and `.File` properties (mirrors the React variant's
// `Object.assign(TreeRoot, { Folder, File })` shape).
const Tree = Object.assign(TreeRoot, { Folder: TreeFolder, File: TreeFile });

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const slug = entry.id === 'index' ? undefined : entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const data = (entry.data ?? {}) as {
  title?: string;
  description?: string;
  mode?: string;
  backgroundColor?: string;
  backgroundColorDark?: string;
};
const title = data.title ?? entry.id;
const description = data.description;
const currentSlug = entry.id;
const isCustomMode = data.mode === 'custom';

// Sanitize per-page background overrides. Tenants own their MDX so this is
// a footgun guard, not a security boundary — a value containing CSS
// terminators or HTML brackets would silently break the inline-style
// declaration we emit, so we drop it instead. Available in both `mode:
// custom` (full-bleed shell) and the default DocsLayout (article + sidebar
// chrome), so any page can paint a branded background.
const sanitizeColor = (raw: unknown): string | undefined => {
  if (typeof raw !== 'string') return undefined;
  const trimmed = raw.trim();
  if (!trimmed) return undefined;
  if (/[;{}\n\r<>]/.test(trimmed)) return undefined;
  return trimmed;
};
const backgroundColor = sanitizeColor(data.backgroundColor);
const backgroundColorDark = sanitizeColor(data.backgroundColorDark);

// Merge Astro variants over the React component map. Astro variants are
// required for:
//   - Tabs/Steps — children-introspection breaks across the Astro+React+MDX
//     boundary (children come through as pre-rendered HTML strings).
//   - Mermaid — needs a `client:visible` directive that the components-map
//     prop can't carry; the Astro wrapper attaches it.
//   - Tree — uses a React Context to propagate depth to nested
//     Tree.Folder/Tree.File children; the Context provider in the parent
//     never connects to descendants because each MDX-rendered component
//     becomes its own React tree on the server.
// Add new entries to BOTH this map AND the auto-import skip list in
// `astro.config.mjs` — otherwise the auto-import plugin shadows this map
// with a raw `import { X } from "@nebula-docs/components"` and the React
// variant wins.
const components = {
  ...reactComponents,
  Steps,
  Step,
  Tabs,
  Tab,
  Mermaid,
  Tree,
  CodeGroup,
  Hero,
};
---
{isCustomMode ? (
  <CustomLayout
    title={title}
    description={description}
    currentSlug={currentSlug}
    backgroundColor={backgroundColor}
    backgroundColorDark={backgroundColorDark}
  >
    <Content components={components} />
  </CustomLayout>
) : (
  <DocsLayout
    title={title}
    description={description}
    currentSlug={currentSlug}
    headings={headings}
    backgroundColor={backgroundColor}
    backgroundColorDark={backgroundColorDark}
  >
    <Content components={components} />
  </DocsLayout>
)}
