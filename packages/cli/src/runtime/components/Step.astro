---
interface Props {
  title?: string;
  icon?: string;
}
const { title } = Astro.props as Props;
---
<li class="nebula-step">
  {title && <p class="nebula-step-title">{title}</p>}
  <div class="nebula-step-content"><slot /></div>
</li>

<style is:global>
  .nebula-step {
    counter-increment: nebula-step;
    position: relative;
    /* Circle column = 1.75rem (circle) + 1.5rem (breathing room before content).
       Wider gap matches Mintlify — the line+circle reads as its own column,
       not as a bullet glued to the prose. */
    padding-left: 3.25rem;
    padding-bottom: 2rem;
  }
  /* Numbered circle. Uses color-mix from `--mcoe-text-heading` so the fill
   * sits a tasteful step darker than the page bg in light mode and a step
   * lighter in dark mode — derived from one source so it tracks any token
   * shift without separate light/dark blocks. Mintlify-aligned contrast. */
  .nebula-step::before {
    content: counter(nebula-step);
    position: absolute;
    left: 0;
    top: 0.125rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--mcoe-text-heading) 6%, var(--mcoe-bg-primary));
    color: var(--mcoe-text-heading);
    font-weight: 600;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--mcoe-text-heading) 14%, transparent);
    z-index: 1;
    line-height: 1;
  }
  /* Connector line between circles. Sits under the circle column with a
   * small gap on both ends so it doesn't kiss the circle borders. The line
   * extends a hair past the step's padding-bottom so it visually meets the
   * next step's circle without a seam. */
  .nebula-step::after {
    content: '';
    position: absolute;
    left: calc(0.875rem - 0.5px);
    top: 2.125rem;
    bottom: -0.25rem;
    width: 1px;
    background: var(--mcoe-border-muted);
  }
  /* Last step: fade the line into transparent instead of hard-cutting at
   * the circle's bottom. Mintlify pattern — the trail tapers off, signalling
   * "end of sequence" without a sudden stop. */
  .nebula-step:last-child::after {
    bottom: auto;
    height: 2.25rem;
    background: linear-gradient(
      to bottom,
      var(--mcoe-border-muted) 0%,
      var(--mcoe-border-muted) 35%,
      transparent 100%
    );
  }
  .nebula-step-title {
    font-weight: 600;
    color: var(--mcoe-text-heading);
    margin: 0 0 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .nebula-step-content > :first-child {
    margin-top: 0;
  }
  .nebula-step-content > :last-child {
    margin-bottom: 0;
  }
</style>
