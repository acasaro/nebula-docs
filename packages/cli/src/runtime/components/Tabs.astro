---
// Astro implementation of <Tabs>. Each <Tab> child renders a section with a
// data-tab-title attribute; this script reads them at page load, builds the
// tab-buttons row dynamically, and wires click + keyboard handling.
//
// Bypasses the Astro+React+MDX children-introspection limitation entirely —
// no React, so the children pass through Astro slots intact.
---
<div class="nebula-tabs" data-component-part="tabs">
  <div class="nebula-tabs-list" role="tablist"></div>
  <div class="nebula-tabs-panels"><slot /></div>
</div>

<style is:global>
  .nebula-tabs {
    margin: var(--mcoe-space-5) 0;
  }
  .nebula-tabs-list {
    display: flex;
    gap: var(--mcoe-space-5);
    border-bottom: 1px solid var(--mcoe-border-default);
    margin-bottom: var(--mcoe-space-4);
    overflow-x: auto;
  }
  .nebula-tabs-list:empty {
    display: none;
  }
  .nebula-tabs-list button {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--mcoe-text-secondary);
    cursor: pointer;
    font: inherit;
    font-size: var(--mcoe-font-size-sm);
    font-weight: var(--mcoe-font-weight-medium);
    padding: var(--mcoe-space-2) 0 calc(var(--mcoe-space-2) + 1px);
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .nebula-tabs-list button:hover {
    color: var(--mcoe-text-primary);
  }
  .nebula-tabs-list button[aria-selected='true'] {
    color: var(--mcoe-text-heading);
    border-bottom-color: var(--mcoe-brand-primary);
  }
  .nebula-tabs-panels [data-nebula-tab][hidden] {
    display: none !important;
  }
  .nebula-tabs-panels [data-nebula-tab] > :first-child {
    margin-top: 0;
  }
  .nebula-tabs-panels [data-nebula-tab] > :last-child {
    margin-bottom: 0;
  }
</style>

<script is:inline>
  (function () {
    function init(root) {
      const list = root.querySelector(':scope > .nebula-tabs-list');
      const panels = root.querySelectorAll(':scope > .nebula-tabs-panels > [data-nebula-tab]');
      if (!list || panels.length === 0 || list.dataset.nebulaInit === '1') return;
      list.dataset.nebulaInit = '1';

      const buttons = [];
      panels.forEach(function (panel, i) {
        const title = panel.getAttribute('data-tab-title') || ('Tab ' + (i + 1));
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        btn.setAttribute('tabindex', i === 0 ? '0' : '-1');
        btn.textContent = title;
        btn.addEventListener('click', function () { activate(i); });
        btn.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
            e.preventDefault();
            const dir = e.key === 'ArrowLeft' ? -1 : 1;
            activate((i + dir + buttons.length) % buttons.length, true);
          } else if (e.key === 'Home') {
            e.preventDefault();
            activate(0, true);
          } else if (e.key === 'End') {
            e.preventDefault();
            activate(buttons.length - 1, true);
          }
        });
        list.appendChild(btn);
        buttons.push(btn);
        panel.hidden = i !== 0;
      });

      function activate(idx, focus) {
        buttons.forEach(function (b, j) {
          b.setAttribute('aria-selected', j === idx ? 'true' : 'false');
          b.setAttribute('tabindex', j === idx ? '0' : '-1');
        });
        panels.forEach(function (p, j) { p.hidden = j !== idx; });
        if (focus && buttons[idx]) buttons[idx].focus();
      }
    }

    function run() {
      document.querySelectorAll('.nebula-tabs').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>
