---
interface Props {
  name: string;
}
const { name } = Astro.props as Props;
---
<div
  role="treeitem"
  aria-selected="false"
  tabindex="-1"
  data-component-part="tree-file"
  class="flex cursor-default items-center gap-1.5 rounded-lg py-1 pl-1.5 pr-1.5 -outline-offset-1 text-stone-700 hover:bg-stone-100 dark:text-stone-400 dark:hover:bg-stone-900"
>
  <svg
    class="size-4 shrink-0 select-none"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
    <path d="M14 2v4a2 2 0 0 0 2 2h4" />
  </svg>
  <span
    class="truncate font-medium text-sm leading-5 -tracking-[0.1px]"
    title={name}
  >{name}</span>
</div>
