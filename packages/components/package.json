{
  "name": "@nebula-docs/components",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nebula-docs/schemas": "workspace:*",
    "@nebula-docs/theme": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.471.2",
    "mermaid": "^11.14.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@types/react": "^19.2.7",
    "react": "^19.2.3",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "registry": "<JFROG_NPM_LOCAL_URL>"
  }
