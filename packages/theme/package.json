{
  "name": "@nebula-docs/theme",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/tokens.css": "./dist/tokens.css",
    "./dist/brand-palette.css": "./dist/brand-palette.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-css.ts dist/tokens.css",
    "build:css": "tsx scripts/build-css.ts dist/tokens.css",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "<JFROG_NPM_LOCAL_URL>"
  }
}
