// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // The base config (@docusaurus/tsconfig) still sets `baseUrl: "."`,
    // which TS 5.7 deprecated. Silence the warning until Docusaurus
    // ships a config without it.
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@site/*": ["./*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@theme/*": ["./src/theme/*"],
      "@types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [".docusaurus", "build"]
}
