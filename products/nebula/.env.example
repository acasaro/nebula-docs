# Firebase web SDK config — copy to .env.local with real values.
# Vite's envPrefix is set to ['FIREBASE_', 'NEBULA_'], so these are exposed
# to client code via import.meta.env. Same key names as products/docs/.env.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGE_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Public install URL for the Nebula GitHub App.
# Format: https://github.com/apps/<app-slug>/installations/new
# (For UHG GitHub Enterprise, swap github.com for the enterprise host.)
NEBULA_APP_INSTALL_URL=
