{
  "$schema": "https://nebula-docs.uhg.com/docs.schema.json",
  "name": "AcmeCloud SDK",
  "description": "Full kitchen-sink Nebula Docs starter — the AcmeCloud SDK reference site exercises every component, nav pattern, and frontmatter field.",
  "favicon": "/assets/favicon.svg",
  "logo": {
    "href": "/"
  },
  "versions": [
    { "version": "v2.4", "default": true }
  ],
  "theme": {
    "base": "mcoe-default",
    "extends": "./theme.json",
    "switcherEnabled": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "concepts/data-model",
              "concepts/architecture"
            ]
          },
          {
            "group": "Tutorials",
            "icon": "graduation-cap",
            "pages": [
              {
                "group": "Build & Deploy",
                "icon": "wrench",
                "pages": [
                  "tutorial/01-setup",
                  "tutorial/02-deploy"
                ]
              }
            ]
          },
          {
            "group": "Resources",
            "icon": "external-link",
            "pages": [
              {
                "page": "resources/changelog",
                "sidebarTitle": "Changelog",
                "icon": "history"
              },
              {
                "slug": "external-status",
                "sidebarTitle": "Status page",
                "externalUrl": "https://status.acmecloud.example",
                "icon": "activity"
              }
            ]
          }
        ]
      },
      {
        "tab": "Components",
        "icon": "layers",
        "groups": [
          {
            "group": "Overview",
            "icon": "list",
            "pages": [
              "components"
            ]
          },
          {
            "group": "Layout",
            "icon": "layout-grid",
            "pages": [
              "components/card",
              "components/columns",
              "components/frame",
              "components/tabs",
              "components/accordion",
              "components/expandable"
            ]
          },
          {
            "group": "Content",
            "icon": "type",
            "pages": [
              "components/callout",
              "components/badge",
              "components/icon",
              "components/steps",
              "components/update"
            ]
          },
          {
            "group": "Code & Data",
            "icon": "code-2",
            "pages": [
              "components/code-block",
              {
                "page": "components/code-group",
                "tag": "Beta",
                "sidebarTitle": "CodeGroup"
              },
              "components/property",
              "components/tree",
              "components/mermaid"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "api"
            ]
          },
          {
            "group": "Users",
            "icon": "users",
            "pages": [
              {
                "page": "api/users/get-user",
                "sidebarTitle": "GET /users/{id}",
                "icon": "search"
              },
              {
                "page": "api/users/create-user",
                "sidebarTitle": "POST /users",
                "icon": "plus"
              },
              {
                "page": "api/users/list-users",
                "sidebarTitle": "GET /users",
                "icon": "list"
              }
            ]
          },
          {
            "group": "Posts",
            "icon": "file-text",
            "pages": [
              {
                "page": "api/posts/get-post",
                "sidebarTitle": "GET /posts/{id}",
                "icon": "search"
              },
              {
                "page": "api/posts/create-post",
                "sidebarTitle": "POST /posts",
                "icon": "plus",
                "tag": "Beta"
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "/quickstart"
    },
    "links": [
      { "label": "Changelog", "href": "/resources/changelog", "icon": "history" },
      { "label": "Support", "href": "/concepts/architecture", "icon": "life-buoy" }
    ]
  },
  "footer": {
    "columns": [
      {
        "label": "Documentation",
        "links": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Concepts", "href": "/concepts/data-model" },
          { "label": "Tutorials", "href": "/tutorial/01-setup" }
