      },
      {
        "label": "API",
        "links": [
          { "label": "Users", "href": "/api/users/get-user" },
          { "label": "Posts", "href": "/api/posts/get-post" }
        ]
      }
    ],
    "copyright": "© AcmeCloud — fictional placeholder content for Nebula Docs starter."
