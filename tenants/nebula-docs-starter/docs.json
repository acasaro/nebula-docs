{
  "$schema": "https://nebula-docs.uhg.com/docs.schema.json",
  "name": "AcmeCloud SDK",
  "description": "Full kitchen-sink Nebula Docs starter — the AcmeCloud SDK reference site exercises every component, nav pattern, and frontmatter field.",
  "favicon": "/assets/favicon.svg",
  "logo": {
    "href": "/"
  },
  "versions": [
    {
      "version": "v2.4",
      "default": true
    }
  ],
  "theme": {
    "base": "mcoe-default",
    "extends": "./theme.json",
    "switcherEnabled": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "landing",
              "resources/changelog",
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "concepts/data-model",
              "concepts/architecture"
            ]
          },
          {
            "group": "Tutorials",
            "icon": "graduation-cap",
            "pages": [
              {
                "group": "Build & Deploy",
                "pages": [
                  "tutorial/01-setup",
                  "tutorial/02-deploy"
                ],
                "expanded": false
              }
            ]
          }
        ],
        "pages": [
          "legal/internal-notes"
        ]
      },
      {
        "tab": "Components",
        "icon": "layers",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "components"
            ]
          },
