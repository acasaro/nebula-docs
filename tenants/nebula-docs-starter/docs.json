              "components/callout",
              "components/badge",
              "components/icon",
              "components/steps",
              "components/update"
            ]
          },
          {
            "group": "Code & Data",
            "icon": "code-2",
            "pages": [
              "components/code-block",
              {
                "page": "components/code-group",
                "tag": "Beta",
                "sidebarTitle": "CodeGroup"
              },
              "components/property",
              "components/tree",
              "components/mermaid"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
